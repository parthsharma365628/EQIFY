<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth headphone auto-detection -->
    <!-- BLUETOOTH_CONNECT: read device name on Android 12+ (runtime permission) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- BLUETOOTH: Android < 12 (granted at install, no runtime request needed) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live spectrum only (FEATURES_BATCH4_PLAN.md A): Android requires it for Visualizer, which
         reads EQify's own audio output, not the microphone. Asked only when the analyser opens. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".EqifyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/Theme.EQify">

        <!-- singleTask: links and shares reuse the existing EQify task (onNewIntent)
             instead of stacking a second copy inside the sending app's task. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.EQify">
            <!-- Rotation and resizing relayout in place instead of recreating the activity,
                 so open sheets and pickers keep their state (FEATURES_BATCH3_PLAN.md §6). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared EQ profile links: eqify://import?p=EQIFY1:… (opens the import preview only). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eqify" android:host="import" />
            </intent-filter>
            <!-- "Share to EQify" from chat apps (opens the import preview only). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Sentry is started manually by CrashReporting so opt-out and scrubbing apply first. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- Pre-download the Google code scanner UI module at install time. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Share card image for "Your week in sound"; only cache/shared/ is exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".EqProcessingService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />

        <service
            android:name="com.example.eqify.MediaListenerService"
            android:label="EQify Media Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name="com.example.eqify.EqQuickSettingsTileService"
            android:exported="true"
            android:icon="@drawable/ic_eq_tile"
            android:label="EQify"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Batch 3 (FEATURES_BATCH3_PLAN.md §E, §G) -->
        <activity
            android:name=".ShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Automation: ignored unless Settings → Automation is on; allowlisted actions only. -->
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.liteplane.eqify.action.SET_EQ" />
                <action android:name="com.liteplane.eqify.action.SET_BASS" />
                <action android:name="com.liteplane.eqify.action.SET_PRESET" />
                <action android:name="com.liteplane.eqify.action.SET_AUTO_GENRE" />
                <action android:name="com.liteplane.eqify.action.SLEEP_TIMER" />
            </intent-filter>
        </receiver>

        <!-- Batch 4 (FEATURES_BATCH4_PLAN.md) -->
        <service
            android:name=".BassTileService"
            android:exported="true"
            android:icon="@drawable/ic_sym_equalizer"
            android:label="Bass"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".SleepTileService"
            android:exported="true"
            android:icon="@drawable/ic_sym_bedtime"
            android:label="Sleep timer"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Watch commands; Google Play services binds it. -->
        <service
            android:name=".WearCommandService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/eqify/command" />
            </intent-filter>
        </service>

        <receiver
            android:name=".EqifyWidget"
            android:exported="false"
            android:label="EQify">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_eqify_info" />
        </receiver>
    </application>

</manifest>
